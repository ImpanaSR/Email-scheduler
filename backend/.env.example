# Server
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox

# Redis (BullMQ + rate limit counters)
REDIS_URL=redis://localhost:6379

# Ethereal (fake SMTP) - leave blank to auto-create a fresh test account on boot
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth (create a project at console.cloud.google.com -> OAuth consent screen -> credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Slack OAuth (create an app at api.slack.com/apps with the "incoming-webhook" scope)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Scheduler behaviour
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
